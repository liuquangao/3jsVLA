{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"],
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
